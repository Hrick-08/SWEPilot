# Copy to .env and fill in — never commit the real .env file.

# --- Azure AI Foundry (OpenAI-compatible endpoint with Entra ID) ---
AZURE_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
AZURE_FOUNDRY_DEPLOYMENT=gpt-5-mini
AZURE_FOUNDRY_API_VERSION=2025-04-01-preview
# Optional: use this instead of Entra ID authentication.
# AZURE_FOUNDRY_API_KEY=

# litellm doesn't have pricing mapped for some Groq-hosted models yet, which
# otherwise crashes the run right after a successful response. This skips
# cost tracking instead of failing the run over it.
MSWEA_COST_TRACKING=ignore_errors

# --- GitHub (used by run_agent.py to push branches and open PRs) ---
GITHUB_TOKEN=
REPO_NAME=your-username/demo-repo
