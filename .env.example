# Copy to .env and fill in — never commit the real .env file.

# --- Azure OpenAI (swap in for the actual submission) ---
AZURE_FOUNDRY_ENDPOINT=<your-azure-openai-endpoint>
AZURE_FOUNDRY_DEPLOYMENT=<your-azure-openai-deployment-name>
AZURE_FOUNDRY_API_KEY=<your-azure-openai-api-key>

# --- GitHub (used by run_agent.py to push branches and open PRs) ---
GITHUB_TOKEN=<your-github-token>
REPO_NAME=<github-username>/<repo-name>

# --- PostgreSQL ---
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/DATABASE
